{
  "name": "portfolio-mari-mou",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env server.ts",
    "build:web": "vite build",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node --env-file-if-exists=.env dist/server.cjs --production",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "animejs": "^4.5.0",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "framer-motion": "^14.1.0",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.26.0",
    "multer": "^2.2.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-select": "^5.10.2",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^5.4.11"
  }
